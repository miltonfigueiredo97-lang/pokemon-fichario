      "html": "<form id=\"login-form\" class=\"modal login-form\" action=\"/site/login\" method=\"post\">\n<input type=\"hidden\" name=\"_csrf\" value=\"ub0Cl2aW8heggDqOxNXILwS14sXDsV7nB-52i0keZbns9nbeVtKeJvLKTaOMgKBAfsSz85HbNtRDgizDA18f4w==\">\n<div class=\"modal-header\">\n    <figure class=\"logo\">\n        <img src=\"https://img.mypcards.com/cdn-cgi/image/f=auto,q=85/logo/logo-mypcards.png\" width=\"92px\" height=\"55px\" alt=\"Logo MYP Cards\" title=\"MYP Cards\">    </figure>\n    <a href=\"#close\" class=\"close\"><span class=\"svg-icon\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M23.065 0L14 9.065L4.935 0L0 4.935L9.065 14L0 23.065L4.935 28L14 18.935L23.065 28L28 23.065L18.935 14L28 4.935L23.065 0Z\" fill=\"currentColor\"></path>\n</svg>\n</span></a>\n</div>\n\n<div class=\"add-card modal-content\">\n    \n<div class=\"alert alert-warning aviso-senhas-invalidadas\">\n    Adotamos um novo padrão de senhas em 04/09/2026.\n    Se a sua parou de funcionar, use\n    <a href=\"/site/esqueci-senha\" data-pjax=\"0\">Esqueci minha senha</a>    para criar uma nova.\n<span class=\"close\"></span></div>\n    <div id=\"w4\"><ul class=\"auth-clients\"><li><a class=\"google auth-link\" href=\"/site/auth?authclient=google\" title=\"Google\"><span class=\"auth-icon google\"></span></a></li><li><a class=\"facebook auth-link\" href=\"/site/auth?authclient=facebook\" title=\"Facebook\" data-popup-width=\"860\" data-popup-height=\"480\"><span class=\"auth-icon facebook\"></span></a></li></ul></div>    <p class=\"center\">-- ou --</p>\n    <div class=\"form-group field-loginform-modal-username required\">\n<label class=\"control-label\" for=\"loginform-modal-username\">Email / Nick</label>\n<input type=\"text\" id=\"loginform-modal-username\" class=\"form-control\" name=\"LoginForm[username]\" oninput=\"if (!window.__cfRLUnblockHandlers) return false; this.value = this.value.replace(/\\s/g, &quot;&quot;);\" aria-required=\"true\">\n\n<div class=\"help-block\"></div>\n</div>\n    <div class=\"form-group field-password-modal-input required\">\n<label class=\"control-label\" for=\"password-modal-input\">Senha</label><div class=\"campo-senha\"><input type=\"password\" id=\"password-modal-input\" class=\"form-control\" name=\"LoginForm[password]\" autocomplete=\"on\" aria-required=\"true\"><button type=\"button\" class=\"olhinho\" data-toggle-senha=\"password-modal-input\" title=\"Mostrar senha\"><span class=\"svg-icon olho\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n  <path d=\"M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z\"></path>\n  <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M.664 10.59a1.651 1.651 0 010-1.186C2.108 5.655 5.744 3 10 3s7.892 2.655 9.336 6.41c.116.355.116.742 0 1.186C17.892 14.345 14.256 17 10 17s-7.892-2.655-9.336-6.41zM14 10a4 4 0 11-8 0 4 4 0 018 0z\"></path>\n</svg>\n</span><span class=\"svg-icon olho-cortado escondido\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n  <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M3.28 2.22a.75.75 0 00-1.06 1.06l14.5 14.5a.75.75 0 101.06-1.06l-1.745-1.745a10.029 10.029 0 003.3-4.38 1.651 1.651 0 000-1.185A10.004 10.004 0 0010 3a9.956 9.956 0 00-4.744 1.194L3.28 2.22zM7.752 6.69l1.092 1.092a2.5 2.5 0 013.374 3.373l1.091 1.092a4 4 0 00-5.557-5.557z\"></path>\n  <path d=\"M10.748 13.93l2.523 2.523a9.987 9.987 0 01-3.27.547c-4.258 0-7.894-2.66-9.337-6.41a1.651 1.651 0 010-1.186A10.007 10.007 0 012.839 6.02L6.07 9.252a4 4 0 004.678 4.678z\"></path>\n</svg>\n</span></button></div><div class=\"help-block\"></div>\n</div>\n    <div class=\"row\">\n        <div class=\"checkbox\">\n            <input type=\"hidden\" name=\"LoginForm[rememberMe]\" value=\"0\">\n            <input type=\"checkbox\" name=\"LoginForm[rememberMe]\" id=\"rememberMe-modal\" value=\"1\" checked=\"\">\n            <label for=\"rememberMe-modal\">Lembrar-me</label>\n        </div>\n    </div>\n\n    <div class=\"btlogin\">\n        <button type=\"submit\" class=\"btn btn-block\" name=\"login-button\">Login</button>    </div>\n\n    <div class=\"criar-conta\">  \n        -- Ainda não tem uma conta? -- "
