      "html": "<form id=\"produtoSearchForm\" action=\"/pokemon\" method=\"get\" class=\"searchbar\">\n                <select id=\"search-marca-selector\" name=\"ProdutoSearch[marca]\" data-usuario-layout=\"\">\n                                            <option value=\"todos\">Todos</option>\n                                            <option value=\"yugioh\">Yu-Gi-Oh!</option>\n                                            <option value=\"pokemon\" selected=\"\">Pokémon</option>\n                                            <option value=\"lorcana\">Lorcana</option>\n                                            <option value=\"onepiece\">One Piece</option>\n                                            <option value=\"riftbound\">Riftbound</option>\n                                            <option value=\"magic\">Magic</option>\n                                            <option value=\"copadomundo2026\">Copa do Mundo 2026</option>\n                                            <option value=\"digimon\">Digimon</option>\n                                            <option value=\"outros\">Produtos</option>\n                                            <option value=\"battlescenes\">Battle Scenes</option>\n                                            <option value=\"dbsfusion\">DBS: Fusion World</option>\n                                            <option value=\"dbsmasters\">DBS: Masters</option>\n                                            <option value=\"fab\">Flesh &amp; Blood</option>\n                                            <option value=\"gundam\">Gundam</option>\n                                            <option value=\"hp\">Harry Potter</option>\n                                            <option value=\"lotr\">Lord of the Rings</option>\n                                            <option value=\"sorcery\">Sorcery: Contested Realm</option>\n                                            <option value=\"swdestiny\">Star Wars: Destiny</option>\n                                            <option value=\"swunlimited\">Star Wars: Unlimited</option>\n                                            <option value=\"vanguard\">Vanguard</option>\n                                            <option value=\"grandarchive\">Grand Archive</option>\n                                            <option value=\"unionarena\">Union Arena</option>\n                                            <option value=\"weissschwarz\">Weiss Schwarz</option>\n                                            <option value=\"warlord\">Warlord</option>\n                                    </select>\n                <div class=\"searchbar-input-wrapper\">\n                    <input type=\"text\" id=\"produtoSearchQuery\" class=\"clearable clearable-dark ui-autocomplete-input\" name=\"ProdutoSearch[query]\" value=\"\" autocomplete=\"off\" placeholder=\"Buscar em Pokémon\">                                    </div>\n                <button id=\"btn-buscar\" type=\"submit\" class=\"btn-buscar\" title=\"Buscar\" aria-label=\"Buscar\">\n                    <span class=\"fa fa-search\" aria-hidden=\"true\"></span>\n                </button>\n            </form>"
    },
