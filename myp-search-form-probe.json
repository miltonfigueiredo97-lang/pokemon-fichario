      "action": "https://mypcards.com/pokemon",
      "method": "get",
      "html": "<form id=\"filtroForm\" action=\"/pokemon\" method=\"get\">\n        <div class=\"active-filters\">\n\n            <ul class=\"filtrados\">\n                                                                                                                                                                                                                                                                                                                                                                                            </ul>\n\n            \n        </div>\n\n                    <div class=\"checkbox field-produtosearch-exibirsomentevenda\">\n<input type=\"checkbox\" id=\"produtosearch-exibirsomentevenda\" name=\"ProdutoSearch[exibirSomenteVenda]\" value=\"1\" 0=\"\" onchange=\"if (!window.__cfRLUnblockHandlers) return false; this.form.submit()\"><label class=\"text-sm\" for=\"produtosearch-exibirsomentevenda\">Exibir somente itens à venda</label>\n</div>        \n        <hr>\n        \n<div class=\"filtro-group\">\n    <button type=\"button\" class=\"filtro-accordion open\" aria-expanded=\"true\">Categorias</button>\n    <input type=\"text\" placeholder=\"Filtrar\" class=\"form-control autocomplete-search filtro-pesquisar hide\">\n\n    <div class=\"form-group field-produtosearch-categoriasselecionadas\">\n<label class=\"control-label\"></label>\n<input type=\"hidden\" name=\"ProdutoSearch[categoriasSelecionadas]\" value=\"\"><ul id=\"produtosearch-categoriasselecionadas\">\n                    <li class=\"radio\">\n                    <input type=\"radio\" name=\"ProdutoSearch[categoriasSelecionadas][]\" id=\"ProdutoSearch[categoriasSelecionadas][]0\" value=\"26\" onchange=\"if (!window.__cfRLUnblockHandlers) return false; $('#filtroForm').submit()\">\n                    <label for=\"ProdutoSearch[categoriasSelecionadas][]0\" class=\"nome\">Acessórios</label>\n                    </li>\n\n                    <li class=\"radio\">\n                    <input type=\"radio\" name=\"ProdutoSearch[categoriasSelecionadas][]\" id=\"ProdutoSearch[categoriasSelecionadas][]1\" value=\"30\" onchange=\"if (!window.__cfRLUnblockHandlers) return false; $('#filtroForm').submit()\">\n                    <label for=\"ProdutoSearch[categoriasSelecionadas][]1\" class=\"nome\">Action Figure</label>\n                    </li>\n\n                    <li class=\"radio\">\n                    <input type=\"radio\" name=\"ProdutoSearch[categoriasSelecionadas][]\" id=\"ProdutoSearch[categoriasSelecionadas][]2\" value=\"32\" onchange=\"if (!window.__cfRLUnblockHandlers) return false; $('#filtroForm').submit()\">\n                    <label for=\"ProdutoSearch[categoriasSelecionadas][]2\" class=\"nome\">Artigos Geek</label>\n                    </li>\n\n                    <li class=\"radio\">\n                    <input type=\"radio\" name=\"ProdutoSearch[categoriasSelecionadas][]\" id=\"ProdutoSearch[categoriasSelecionadas][]3\" value=\"54\" onchange=\"if (!window.__cfRLUnblockHandlers) return false; $('#filtroForm').submit()\">\n                    <label for=\"ProdutoSearch[categoriasSelecionadas][]3\" class=\"nome\">Cartas Graduadas</label>\n                    </li>\n\n                    <li class=\"radio\">\n                    <input type=\"radio\" name=\"ProdutoSearch[categoriasSelecionadas][]\" id=\"ProdutoSearch[categoriasSelecionadas][]4\" value=\"29\" onchange=\"if (!window.__cfRLUnblockHandlers) return false; $('#filtroForm').submit()\">\n                    <label for=\"ProdutoSearch[categoriasSelecionadas][]4\" class=\"nome\">Deck / Lote / Set</label>\n                    </li>\n\n                    <li class=\"radio\">\n                    <input type=\"radio\" name=\"ProdutoSearch[categoriasSelecionadas][]\" id=\"ProdutoSearch[categoriasSelecionadas][]5\" value=\"28\" onchange=\"if (!window.__cfRLUnblockHandlers) return false; $('#filtroForm').submit()\">\n                    <label for=\"ProdutoSearch[categoriasSelecionadas][]5\" class=\"nome\">HQ / Livros</label>\n                    </li>\n\n                    <li class=\"radio\">\n                    <input type=\"radio\" name=\"ProdutoSearch[categoriasSelecionadas][]\" id=\"ProdutoSea"
    },
